# Copy this file to .env and fill in real values.
# Never commit the actual .env file to version control.

# ── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=hr_vacancy
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Switch backend to smtp.EmailBackend for real email delivery.
# Keep console.EmailBackend during local development (prints to terminal).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail: use an App Password (not your main password).
# Go to https://myaccount.google.com/apppasswords to generate one.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# "From" address that appears in the candidate's inbox
DEFAULT_FROM_EMAIL=HR Portal <noreply@yourorg.com>
